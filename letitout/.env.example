# Philofi / Unsaid — Azure OpenAI (server-side only)
# Copy to `.env.local` and fill in real values from your Azure portal.
# Never commit `.env.local` or real keys. Do not invent credentials.

# Resource endpoint without trailing slash, e.g. https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_ENDPOINT=

# Key from the Azure OpenAI resource (Keys and Endpoint)
AZURE_OPENAI_API_KEY=

# Deployment name of the chat model (not the model family name alone)
AZURE_OPENAI_DEPLOYMENT=

# API version string, e.g. 2024-08-01-preview
AZURE_OPENAI_API_VERSION=2024-08-01-preview
